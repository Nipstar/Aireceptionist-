# ─────────────────────────────────────────────────────────────────────────────
# AI Voice Agent Receptionist — environment variables
#
# Copy this file to `.env.local` for local dev, or paste these into your host's
# dashboard (e.g. Vercel → Settings → Environment Variables).
#
# Every value is PUBLIC — it ships to the browser. Do NOT put private secrets
# here. All vars are optional: if unset, the app falls back to the defaults
# baked into lib/site.ts, so the build works with no env file at all.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical base URL (no trailing slash). Drives the canonical tag, Open Graph
# URLs, the sitemap <loc> and robots.txt. Must match the ONE host that actually
# serves the site; redirect the other host to it. Canonical is the apex
# (non-www) — make sure the apex domain actually serves and redirect www → apex.
NEXT_PUBLIC_SITE_URL=https://aivoiceagentreceptionist.co.uk

# Google Analytics 4 measurement ID. Swap this to use a separate GA4 property
# instead of rolling the satellite into the parent's property.
NEXT_PUBLIC_GA4_ID=G-C7MMT455TB

# Microsoft Clarity project ID (loaded only after cookie-consent Accept).
NEXT_PUBLIC_CLARITY_ID=ww6ws9q0if

# n8n webhook both forms POST leads to.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=https://antekauto.app.n8n.cloud/webhook/29e3a09b-5b23-489b-a800-a07262afb4cb

# Cal.com booking link (the "<team-or-user>/<event>" slug).
NEXT_PUBLIC_CAL_LINK=antek-automation/30min

# Retell chat widget credentials.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=public_key_b96440ad931cbd5326e4d
NEXT_PUBLIC_RETELL_AGENT_ID=agent_1c30d12544e2aedfc07ac8be1c
